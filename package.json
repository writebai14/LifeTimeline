{
  "name": "lifetimeline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite\"",
    "desktop": "node electron/dev.cjs",
    "server": "node server/index.js",
    "build": "tsc && vite build",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "build": {
    "appId": "com.writebai14.lifetimeline",
    "productName": "LifeTimeline",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "LifeTimeline-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "exifr": "^7.1.3",
    "express": "^4.21.0",
    "lucide-react": "^1.7.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.0.1",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
