# Generate with: openssl rand -hex 32 (URL-safe hexadecimal; no default password)
POSTGRES_PASSWORD=
APP_VERSION=local
LIFETIMELINE_DAY_HISTORY_LIMIT=30
# Personal SSH-tunnel deployment. Keep the app bound to 127.0.0.1 in compose.
APP_ORIGIN=http://localhost:3001
ALLOW_HTTP_LOOPBACK=true
# For local development only; do not point TEST_DATABASE_URL at production.
# DATABASE_URL=postgres://localhost/lifetimeline_dev
# APP_ORIGIN=http://localhost:5173
# TEST_DATABASE_URL=postgres://localhost/lifetimeline_test
